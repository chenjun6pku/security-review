{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Security Review Finding",
  "type": "object",
  "required": [
    "id",
    "title",
    "severity",
    "confidence",
    "behavior",
    "primary_domain",
    "lifecycle",
    "risk",
    "affected",
    "evidence",
    "trigger",
    "impact",
    "remediation"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^SR-[0-9]{4}$"},
    "title": {"type": "string", "minLength": 1},
    "severity": {"type": "string", "enum": ["Critical", "High", "Medium", "Low", "Informational"]},
    "confidence": {"type": "string", "enum": ["Confirmed", "High", "Medium", "Low"]},
    "behavior": {"type": "string", "enum": ["benign_or_expected_capability", "security_relevant_capability", "reachable_security_behavior", "suspicious_behavior", "confirmed_malicious_behavior"]},
    "primary_domain": {"type": "string", "enum": ["SR-SC", "SR-LC", "SR-BL", "SR-HP", "SR-ID", "SR-DA", "SR-RT", "SR-NW", "SR-AS", "SR-AG"]},
    "issue_type": {"type": "string", "enum": ["memory-safety", "injection", "authn-authz", "privilege-escalation", "credential-exposure", "data-privacy", "information-disclosure", "denial-of-service", "backdoor-covert-channel", "supply-chain", "lifecycle-behavior", "hardening-config", "crypto-protocol", "compliance-license", "agentic-risk"]},
    "lifecycle": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "risk": {"type": "string", "minLength": 1},
    "affected": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path"],
        "properties": {
          "path": {"type": "string"},
          "lines": {"type": "string"},
          "symbol": {"type": "string"},
          "component": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "description"],
        "properties": {
          "kind": {"type": "string", "enum": ["source", "config", "dependency", "build", "ci", "runtime", "network", "agent", "artifact", "negative"]},
          "path": {"type": "string"},
          "lines": {"type": "string"},
          "description": {"type": "string"},
          "redacted": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    },
    "trigger": {"type": "string"},
    "preconditions": {"type": "array", "items": {"type": "string"}},
    "reachability": {"type": "string"},
    "privilege": {"type": "string"},
    "impact": {
      "type": "object",
      "required": ["categories", "summary"],
      "properties": {
        "categories": {"type": "array", "items": {"type": "string", "enum": ["confidentiality", "integrity", "availability", "identity-compromise", "host-compromise", "cloud-compromise", "source-compromise", "supply-chain-compromise", "financial-abuse", "privacy", "ip-license"]}, "uniqueItems": true},
        "summary": {"type": "string"},
        "blast_radius": {"type": "string"}
      },
      "additionalProperties": false
    },
    "attack_chain": {"type": "string"},
    "maliciousness_basis": {"type": "string"},
    "remediation": {"type": "string"},
    "validation": {"type": "string"},
    "frameworks": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "status": {"type": "string", "enum": ["open", "accepted", "fixed", "mitigated", "not_applicable", "needs_review"]}
  },
  "additionalProperties": false
}
